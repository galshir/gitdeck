{
  "name": "gitdeck",
  "displayName": "GitDeck",
  "description": "Your git flow in one panel: switch branches in one click. Each branch gets its own worktree with shared node_modules/.env, its own ports, and a live run status.",
  "version": "0.1.0",
  "publisher": "barmelamed",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitdeck",
          "title": "GitDeck",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "gitdeck": [
        {
          "id": "gitdeck.branches",
          "name": "Branches"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitdeck.branches",
        "contents": "Open a file from a git repository, or pick one.\n[Choose Repository](command:gitdeck.chooseRepo)"
      }
    ],
    "commands": [
      { "command": "gitdeck.chooseRepo", "title": "Choose Repository…", "category": "GitDeck", "icon": "$(repo)" },
      { "command": "gitdeck.refresh", "title": "Refresh", "category": "GitDeck", "icon": "$(refresh)" },
      { "command": "gitdeck.newBranch", "title": "New Branch…", "category": "GitDeck", "icon": "$(add)" },
      { "command": "gitdeck.openConfig", "title": "Open Config", "category": "GitDeck", "icon": "$(gear)" },
      { "command": "gitdeck.open", "title": "Switch to Branch", "category": "GitDeck" },
      { "command": "gitdeck.openNewWindow", "title": "Open in New Window", "category": "GitDeck", "icon": "$(empty-window)" },
      { "command": "gitdeck.start", "title": "Start Services", "category": "GitDeck", "icon": "$(play)" },
      { "command": "gitdeck.stop", "title": "Stop Services", "category": "GitDeck", "icon": "$(debug-stop)" },
      { "command": "gitdeck.openBrowser", "title": "Open in Browser", "category": "GitDeck", "icon": "$(globe)" },
      { "command": "gitdeck.showLogs", "title": "Show Logs", "category": "GitDeck", "icon": "$(output)" },
      { "command": "gitdeck.relink", "title": "Re-link Shared Files", "category": "GitDeck" },
      { "command": "gitdeck.remove", "title": "Remove Worktree…", "category": "GitDeck", "icon": "$(trash)" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "gitdeck.open", "when": "false" },
        { "command": "gitdeck.openNewWindow", "when": "false" },
        { "command": "gitdeck.start", "when": "false" },
        { "command": "gitdeck.stop", "when": "false" },
        { "command": "gitdeck.openBrowser", "when": "false" },
        { "command": "gitdeck.showLogs", "when": "false" },
        { "command": "gitdeck.relink", "when": "false" },
        { "command": "gitdeck.remove", "when": "false" }
      ],
      "view/title": [
        { "command": "gitdeck.newBranch", "when": "view == gitdeck.branches && gitdeck.ready", "group": "navigation@1" },
        { "command": "gitdeck.refresh", "when": "view == gitdeck.branches && gitdeck.ready", "group": "navigation@2" },
        { "command": "gitdeck.openConfig", "when": "view == gitdeck.branches && gitdeck.ready", "group": "navigation@3" },
        { "command": "gitdeck.chooseRepo", "when": "view == gitdeck.branches && !gitdeck.pinned", "group": "navigation@4" }
      ],
      "view/item/context": [
        { "command": "gitdeck.start", "when": "view == gitdeck.branches && viewItem =~ /;svc;/ && viewItem =~ /;idle;/", "group": "inline@1" },
        { "command": "gitdeck.stop", "when": "view == gitdeck.branches && viewItem =~ /;active;/", "group": "inline@1" },
        { "command": "gitdeck.openBrowser", "when": "view == gitdeck.branches && viewItem =~ /;service;/", "group": "inline@1" },
        { "command": "gitdeck.showLogs", "when": "view == gitdeck.branches && viewItem =~ /;service;/", "group": "inline@2" },
        { "command": "gitdeck.openNewWindow", "when": "view == gitdeck.branches && viewItem =~ /;branch;/", "group": "inline@2" },
        { "command": "gitdeck.open", "when": "view == gitdeck.branches && viewItem =~ /;other;/", "group": "1_open@1" },
        { "command": "gitdeck.openNewWindow", "when": "view == gitdeck.branches && viewItem =~ /;branch;/", "group": "1_open@2" },
        { "command": "gitdeck.relink", "when": "view == gitdeck.branches && viewItem =~ /;removable;/", "group": "2_manage@1" },
        { "command": "gitdeck.remove", "when": "view == gitdeck.branches && viewItem =~ /;removable;/", "group": "2_manage@2" }
      ]
    },
    "configuration": {
      "title": "GitDeck",
      "properties": {
        "gitdeck.worktreesDir": {
          "type": "string",
          "default": "",
          "description": "Where branch worktrees are created. Default: <repo parent>/.gitdeck/<repo name>."
        },
        "gitdeck.pollInterval": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "description": "How often (ms) to refresh branch and service status while the view is visible."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
